# Copy to .env and fill in values from https://dashboard.algolia.com
# Settings → API Keys. Never commit .env.

# Algolia Application ID (public; also in docusaurus.config.js)
APPLICATION_ID=L057IAF2ES

# Admin API key — required for yarn algolia:upload and yarn algolia:config
# Do not use the Search-Only key here.
ADMIN_API_KEY=

# Optional. Defaults to "creative" if omitted.
ALGOLIA_INDEX_NAME=creative
